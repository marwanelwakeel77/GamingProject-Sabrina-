  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Alex\u2026 if you can hear this, then you have succeeded.\n\nThe three
    symbols have finally broken the curse. I spent years trying to stop what was
    hidden beneath this school.\n\nI am sorry I couldn't escape. The truth is\u2026
    I was never missing. I was trapped here, between life and death.\n\nThe ghost
    you saw was me.\n\nThank you for setting me free.\n\nNow leave this place. Your
    story ends here\u2026 but mine can finally rest.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
